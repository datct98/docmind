# ============================================================
# DocMind — MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Copy sang .env rồi điền giá trị cấu hình tương ứng:
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env đã nằm trong .gitignore — KHÔNG commit giá trị thật lên git.
# ============================================================

# --- Postgres (dùng bởi service postgres trong docker-compose) ---
POSTGRES_PASSWORD=docmind

# --- api-java datasource ---
# Ngoài compose (api trên host): localhost:5433
# Trong mạng compose: jdbc:postgresql://postgres:5432/docmind
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/docmind
SPRING_DATASOURCE_USERNAME=docmind
SPRING_DATASOURCE_PASSWORD=docmind

# --- Kết nối tới service parser Python (doc-service-py) ---
# Ngoài compose: http://localhost:8091
# Trong compose: http://doc-service-py:8091
DOC_SERVICE_BASE_URL=http://doc-service-py:8091

# ============================================================
# LLM — Unified Multi-Provider Configuration (Requirement R4)
# Hỗ trợ: ollama | deepseek | grok | openai | gemini | openrouter | custom | stub
# Chỉ cần đổi LLM_PROVIDER và điền LLM_API_KEY tương ứng.
# ============================================================
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# CÁC MẪU CẤU HÌNH NHÀ CUNG CẤP SẴN SÀNG SỬ DỤNG (Bỏ comment 1 khối để kích hoạt):
# ------------------------------------------------------------

# [Preset 1] Ollama Local (Mặc định cho máy cá nhân / offline)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=

# [Preset 2] DeepSeek (Chat hoặc Reasoning DeepSeek-R1)
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Preset 3] Grok / xAI (grok-2-latest hoặc grok-3-mini)
# LLM_PROVIDER=grok
# LLM_MODEL=grok-2-latest
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Preset 4] OpenAI (gpt-4o-mini hoặc gpt-4o)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Preset 5] Google Gemini (OpenAI-compatible REST endpoint)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Preset 6] OpenRouter (Cổng chuyển tiếp đa mô hình)
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxx

# [Preset 7] Custom Local / On-Premise OpenAI Compatible (vLLM, LMStudio, FastChat, LocalAI)
# LLM_PROVIDER=custom
# LLM_MODEL=meta-llama-3-8b-instruct
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=

# ------------------------------------------------------------
# Legacy Fallback properties (Tương thích ngược)
# ------------------------------------------------------------
GEMINI_API_KEYS=
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:7b

# --- Observability / Vận hành ---
FRONTEND_PORT=3000
DOCMIND_LOG_LEVEL=INFO
DOCMIND_PERSIST_ARTIFACTS=false

# --- Cloudflare Tunnel (Để trống sẽ chạy Quick Tunnel *.trycloudflare.com; điền token để dùng domain cố định) ---
CLOUDFLARE_TUNNEL_TOKEN=

