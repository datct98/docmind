# Auto-detect text files and normalize to LF in Git index
* text=auto

# Force LF line endings for Linux/Ubuntu Docker deployment scripts & configs
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
.env.example text eol=lf
.dockerignore text eol=lf

# Windows batch scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
